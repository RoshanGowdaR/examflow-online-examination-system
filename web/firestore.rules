rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function hasUserDoc() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isActive() {
      return signedIn() && (!hasUserDoc() || myUser().active == true);
    }
    function isAdmin() {
      return signedIn() && (
        (hasUserDoc() && myUser().role == 'admin') ||
        request.auth.token.email == 'gowdaroshan49@gmail.com'
      );
    }
    function isFaculty() {
      return isAdmin() || (hasUserDoc() && myUser().role == 'faculty');
    }

    match /users/{uid} {
      // Users can read own profile; Admin can read all; Faculty can read student profiles
      allow read: if signedIn();
      // Admins can manage users; users can update their own profile document
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if signedIn();
      allow create, update, delete: if isFaculty();
    }

    match /exams/{examId} {
      allow read: if signedIn();
      allow create, update, delete: if isFaculty();

      match /questions/{questionId} {
        allow read: if signedIn();
        allow create, update, delete: if isFaculty();
      }
    }

    // Answer keys: Accessible by faculty and admin for assessment authoring and automated evaluation
    match /answerKeys/{examId} {
      allow read, write: if isFaculty();
    }

    // Results: Authenticated students can submit their assessments. Faculty and Admins can review all submissions.
    match /results/{resultId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // Audit events & activity logs
    match /auditEvents/{eventId} {
      allow read, write: if signedIn();
    }
  }
}
