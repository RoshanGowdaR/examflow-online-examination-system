# ==============================================================================
# ExamFlow (Group 12) - Production & Local Docker Environment Variables
# Copy this file to .env and provide your actual secrets. NEVER commit .env!
# ==============================================================================

# Server Runtime Configuration
NODE_ENV=production
PORT=10000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Backend Trusted Services (Server-Side / Docker / Render)
# ------------------------------------------------------------------------------
# Minified single-line JSON of your Firebase Admin Service Account key.
# Required for: trusted faculty/student account creation and server-side grading.
# Obtained from: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON=

# Google Gemini API Key for AI exam generation
# Obtained from: Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Vite Build / Browser Runtime)
# Obtained from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=online-examamination.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=online-examamination
VITE_FIREBASE_STORAGE_BUCKET=online-examamination.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: External AWS API Gateway URL (leave empty when using unified Docker / Render container)
VITE_AWS_GRADING_API_URL=
